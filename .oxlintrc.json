{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "plugins": ["eslint", "typescript", "unicorn", "import", "promise"],
  "rules": {
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],
    "no-debugger": "error",
    "no-console": "off",
    "prefer-const": "error",
    "no-var": "error",
    "no-unused-vars": "off",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "warn",
    "unicorn/prefer-node-protocol": "error",
    "import/no-cycle": "error"
  },
  "ignorePatterns": ["node_modules/**", "dist/**", "coverage/**", ".factory/**"]
}
